# Copie para .env e substitua TODOS os valores CHANGE_ME. Nunca versione .env.
POSTGRES_DB=minishop
POSTGRES_USER=minishop
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_RANDOM
SERVICE_KEY=CHANGE_ME_SERVICE_32_CHARACTERS_MINIMUM
ADMIN_KEY=CHANGE_ME_ADMIN_32_CHARACTERS_MINIMUM
ADMIN_PASSWORD=CHANGE_ME_LOGIN_16_CHARACTERS_MINIMUM
# IP Tailscale da VM. Apenas compose.home publica a API nesta interface.
HOME_TAILSCALE_IP=100.100.100.10
# Na Oracle, URL privada da API doméstica.
API_BASE_URL=http://100.100.100.10:5081
# Opcional: IP Tailscale da Oracle para publicar o site só em loopback/Tailscale.
WEB_BIND_IP=127.0.0.1
# Opcional worker ARM: conta PostgreSQL de worker, não superusuário.
WORKER_DB_CONNECTION=Host=100.100.100.10;Port=5432;Database=minishop;Username=minishop_worker;Password=CHANGE_ME;Timeout=5;Command Timeout=30;GSS Encryption Mode=Disable

# Somente ao ativar o overlay opcional deploy/compose.cpu-affinity.yml.
# IDs precisam existir na VM; não interfere no deployment padrão.
MINISHOP_WORKER_CPUSET=0-3
